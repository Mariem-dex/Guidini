<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background photo "Bg" -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Splash Background"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_tunisia" />

    <!-- Dark gradient overlay for perfect readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#50000000" />

    <!-- Light/Dark Mode Toggle Button in top left -->
    <ImageButton
        android:id="@+id/btnThemeToggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:background="@drawable/bg_white_translucent_pill"
        android:contentDescription="Passer en mode sombre"
        android:src="@drawable/ic_dark_mode"
        app:tint="@color/white" xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Title "TuniGuide" at the top, white, bold, highly visible -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:letterSpacing="0.05"
        android:shadowColor="#90000000"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="10"
        android:text="TuniGuide"
        android:textColor="@color/white"
        android:textSize="52sp"
        android:textStyle="bold" />

    <!-- Button with white background and red text in the middle slightly towards the top -->
    <Button
        android:id="@+id/btnExplore"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_centerInParent="true"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/bg_button_white"
        android:elevation="8dp"
        android:text="Commencer l'aventure"
        android:textAllCaps="false"
        android:textColor="@color/harissa_red"
        android:textSize="18sp"
        android:textStyle="bold" />

</RelativeLayout>
